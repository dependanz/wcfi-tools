# Copy to .env for local/dev use, or run `wcfi setup` to store keys in your OS keyring instead.
# Precedence at runtime: CLI flag > environment variable > .env > OS keyring > interactive prompt.

# Required for OpenAI transcription (gpt-4o-transcribe) and, if chosen, OpenAI summarization.
OPENAI_API_KEY=

# Required only if you pick Anthropic/Claude as the summarizer.
ANTHROPIC_API_KEY=

# Required only for local speaker identification (pyannote models are gated on Hugging Face).
# HUGGINGFACE_TOKEN / HUGGING_FACE_HUB_TOKEN are also honored.
HF_TOKEN=
